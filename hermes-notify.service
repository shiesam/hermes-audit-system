[Unit]
Description=Hermes Task Notification Service
After=network.target

[Service]
Type=simple
User=vboxuser
WorkingDirectory=%h/hermes-audit-system
ExecStart=/usr/bin/python3 %h/hermes-audit-system/notify_tasks.py --db /srv/samba/hermes-audit/agent-mesh.db --receiver host --deliver origin --state-file /var/tmp/hermes-notify-state.json
Restart=on-failure
RestartSec=2
StandardOutput=append:/var/log/hermes-notify.log
StandardError=append:/var/log/hermes-notify.log

[Install]
WantedBy=multi-user.target
