# =============================================================================
# Hermes Audit System - 蝦米 (Shrimp) 筆電端環境變數配置文件範例
#
# 使用方法：
#   1. 複製本檔為 `shrimp_config.env`
#   2. 依實際環境修改各欄位（尤其是密碼）
#   3. 勿將含有真實密碼的 shrimp_config.env 提交至 Git
#      （已列入 .gitignore）
# =============================================================================

# ------------------------- 基礎設定 -------------------------
AGENT_NAME=shrimp
AGENT_ROLE=laptop
HERMES_WORKSPACE=D:/hermes-workspace/hermes-audit-system

# ------------------------- 主機連線設定 -------------------------
HOST_IP=192.168.0.68
HOST_SMB_USER=hermes
HOST_SMB_PASS=
HOST_SMB_SHARE=hermes-audit
HOST_SMB_PATH=//192.168.0.68/hermes-audit

# ------------------------- 共享資料庫設定 -------------------------
# 掛載後的本地磁碟機代稱（預設 Z:）
SMB_MOUNT_DRIVE=Z:
# 資料庫檔案在 SMB 共享中的路徑
AGENT_MESH_DB_NAME=agent-mesh.db
# 完整路徑（掛載後）
AGENT_MESH_DB_PATH=${SMB_MOUNT_DRIVE}/${AGENT_MESH_DB_NAME}

# ------------------------- watchdog 設定 -------------------------
WATCHDOG_INTERVAL_SEC=60
WATCHDOG_LOG_DIR=${HERMES_WORKSPACE}/logs/watchdog

# ------------------------- 角色互換測試設定 -------------------------
ROLE_SWAP_TEST_ENABLED=true
ROLE_SWAP_LOG=${HERMES_WORKSPACE}/logs/role_swap.log

# ------------------------- 除錯與日誌 -------------------------
LOG_LEVEL=INFO
PYTHON_BIN=python
